[Unit]
Description=On-demand Elgato Facecam MJPEG relay
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/facecam-mjpeg-loopback
ExecStart=%h/.local/share/facecam-mjpeg-loopback/scripts/relay.py --config %h/.config/facecam-mjpeg-loopback/facecam-loopback.env
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target

