# Copy to facecam-loopback.env and adjust if needed.

# Prefer a stable /dev/v4l/by-id path. Leave empty for auto-detection.
FACECAM_DEVICE=
FACECAM_DEVICE_GLOB=/dev/v4l/by-id/*Elgato*Facecam*

# Virtual camera settings.
# WebEx is more reliable with low-numbered /dev/video nodes. Pick the first
# unused number after your physical cameras.
LOOPBACK_DEVICE=/dev/video6
LOOPBACK_VIDEO_NR=6
LOOPBACK_LABEL="Facecam MJPEG Proxy"
LOOPBACK_EXCLUSIVE_CAPS=1

# Capture settings.
WIDTH=1280
HEIGHT=720
FPS=30
INPUT_FORMAT=mjpeg
OUTPUT_MODE=raw
OUTPUT_PIXEL_FORMAT_FFMPEG=yuyv422
OUTPUT_PIXEL_FORMAT_GST=YUY2

# Keep the virtual camera discoverable without keeping the real camera active.
PLACEHOLDER_FPS=5
MJPEG_PLACEHOLDER_QUALITY=31
IDLE_TIMEOUT_SECONDS=5
POLL_INTERVAL_SECONDS=0.5

# Extra ffmpeg arguments, split shell-style.
FFMPEG_INPUT_EXTRA=
FFMPEG_OUTPUT_EXTRA=
